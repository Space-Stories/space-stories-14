<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="Управление Активами"
                      MinSize="400 500">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="10">
        <PanelContainer StyleClasses="BackgroundPanelDark">
            <BoxContainer Orientation="Vertical" Margin="5" SeparationOverride="5">
                <Label Text="УПРАВЛЕНИЕ КОДАМИ:" Align="Center" StyleClasses="StatusFieldTitle" />
                <Label Text="Станция:" />
                <OptionButton Name="StationSelector" MinWidth="250" />

                <BoxContainer Orientation="Horizontal" SeparationOverride="10">
                    <Label Text="Текущий код:" />
                    <Label Name="CurrentAlertLevelLabel" Text="Неизвестно" />
                </BoxContainer>

                <BoxContainer Margin="0 12 0 6">
                    <Label Text="Код:" StyleClasses="OpenRight"
                        HorizontalExpand="True" SizeFlagsStretchRatio="1" />
                    <OptionButton Name="AlertLevelSelector" StyleClasses="OpenLeft"
                        ToolTip="{Loc 'comms-console-menu-alert-level-button-tooltip'}"
                        HorizontalExpand="True" SizeFlagsStretchRatio="6"/>
                </BoxContainer>

                <Button Name="SetAlertLevelButton" Text="Установить код"
                    Disabled="True" />
            </BoxContainer>
        </PanelContainer>

        <Control StyleClasses="LowDivider" />

        <PanelContainer StyleClasses="BackgroundPanelDark">
            <BoxContainer Orientation="Vertical" Margin="5" SeparationOverride="5">
                <Label Text="УПРАВЛЕНИЕ ЭВАКУАЦИЕЙ:" Align="Center" StyleClasses="StatusFieldTitle" />
                <Label Text="Время (не менее 2-х и не более 30-и минут):" StyleClasses="ButtonSmall" />
                <LineEdit Name="EvacTimeInput" Text="4:00" PlaceHolder="Мин:Сек, например, 4:00" />

                <Button Name="CallEvacButton" Text="Начать эвакуацию" />
                <Button Name="RecallEvacButton" Text="Прервать эвакуацию" />

                <PanelContainer StyleClasses="BackgroundDark">
                    <BoxContainer Orientation="Vertical">
                        <Label StyleClasses="LabelSubText" Align="Center"
                            Text="Время прибытия:" />
                        <Label Name="CountdownLabel" ReservesSpace="True" Align="Center"/>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>