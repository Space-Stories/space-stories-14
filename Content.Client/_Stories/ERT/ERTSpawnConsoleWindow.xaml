<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="ERT Call Console"
                      MinSize="600 450">
    <BoxContainer Orientation="Vertical" Margin="10">

        <PanelContainer Name="BalanceCard" Margin="0 0 0 8">
            <BoxContainer Orientation="Horizontal" Margin="8" SeparationOverride="6">
                <Label Name="BalanceLabel" Text="Balance:" />
                <Label Name="BalanceValueLabel" Text="0" FontColorOverride="Gold" />
            </BoxContainer>
        </PanelContainer>

        <ScrollContainer VerticalExpand="True">
            <BoxContainer Name="OptionsContainer" Orientation="Vertical" />
        </ScrollContainer>

    </BoxContainer>
</controls:FancyWindow>