<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      MinSize="760 520"
                      Resizable="False">
    <PanelContainer Name="Backdrop">
        <BoxContainer Orientation="Vertical">
            <BoxContainer Orientation="Horizontal" Margin="10 8 10 8" SeparationOverride="10">
                <BoxContainer Orientation="Vertical" SeparationOverride="6" MinWidth="420">
                    <PanelContainer Name="TablePanel">
                        <LayoutContainer Name="TableLayout" Margin="6" MinSize="384 260" HorizontalAlignment="Center">
                            <TextureRect Name="TableImage" SetSize="384 224" Stretch="KeepCentered" TextureScale="2 2" />
                        </LayoutContainer>
                    </PanelContainer>
                    <PanelContainer Name="StatusPanel">
                        <BoxContainer Orientation="Vertical" Margin="8 4">
                            <RichTextLabel Name="StatusLabel" HorizontalAlignment="Center" MaxWidth="400" />
                            <Label Name="TimerLabel" StyleClasses="LabelSubText" HorizontalAlignment="Center" Visible="False" />
                        </BoxContainer>
                    </PanelContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                        <Button Name="ReadyButton" Text="{Loc 'stories-blackjack-ready'}" HorizontalExpand="True" MinHeight="32" Visible="False" />
                        <Button Name="LeaveButton" Text="{Loc 'stories-blackjack-leave'}" HorizontalExpand="True" MinHeight="32" Visible="False" />
                        <Button Name="SpectateButton" Text="{Loc 'stories-blackjack-spectate'}" HorizontalExpand="True" MinHeight="32" Visible="False" />
                    </BoxContainer>
                </BoxContainer>
                <BoxContainer Orientation="Vertical" MinWidth="300" MaxWidth="300" SeparationOverride="6">
                    <PanelContainer Name="RulesPanel">
                        <BoxContainer Orientation="Vertical" Margin="8 6" SeparationOverride="4">
                            <Label Text="{Loc 'stories-blackjack-rules-title'}" StyleClasses="LabelHeading" Name="RulesTitle" />
                            <RichTextLabel Name="RulesBody" MaxWidth="280" />
                            <Label Name="LimitsLabel" Visible="False" />
                        </BoxContainer>
                    </PanelContainer>
                    <PanelContainer Name="CashierPanel" Visible="False">
                        <BoxContainer Orientation="Vertical" Margin="8 6" SeparationOverride="4">
                            <Label Text="{Loc 'stories-blackjack-cashier-title'}" StyleClasses="LabelHeading" Name="CashierTitle" />
                            <Label Name="StackLabel" />
                            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                                <Label Text="{Loc 'stories-blackjack-cashier-amount'}" VerticalAlignment="Center" />
                                <LineEdit Name="AmountEdit" Text="50" HorizontalExpand="True" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                                <Label Text="{Loc 'stories-blackjack-cashier-buy-label'}" MinWidth="90" VerticalAlignment="Center" />
                                <Button Name="BuyCashButton" Text="{Loc 'stories-blackjack-cashier-buy-cash'}" HorizontalExpand="True" />
                                <Button Name="BuyCardButton" Text="{Loc 'stories-blackjack-cashier-buy-card'}" HorizontalExpand="True" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                                <Label Text="{Loc 'stories-blackjack-cashier-cashout-label'}" MinWidth="90" VerticalAlignment="Center" />
                                <Button Name="CashOutButton" Text="{Loc 'stories-blackjack-cashier-cashout'}" HorizontalExpand="True" />
                                <Button Name="CashOutCardButton" Text="{Loc 'stories-blackjack-cashier-cashout-card'}" HorizontalExpand="True" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                                <Button Name="DepositButton" Text="{Loc 'stories-blackjack-cashier-deposit'}" HorizontalExpand="True" />
                                <Button Name="WithdrawButton" Text="{Loc 'stories-blackjack-cashier-withdraw'}" HorizontalExpand="True" />
                            </BoxContainer>
                        </BoxContainer>
                    </PanelContainer>
                    <PanelContainer Name="WinsPanel" Visible="False" VerticalExpand="True">
                        <BoxContainer Orientation="Vertical" Margin="8 6" SeparationOverride="4">
                            <Label Text="{Loc 'stories-blackjack-wins-title'}" StyleClasses="LabelHeading" Name="WinsTitle" />
                            <ScrollContainer VerticalExpand="True" MinHeight="120" HScrollEnabled="False">
                                <BoxContainer Name="WinsList" Orientation="Vertical" SeparationOverride="2" />
                            </ScrollContainer>
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </BoxContainer>
            <BoxContainer Orientation="Vertical">
                <PanelContainer StyleClasses="LowDivider" />
                <BoxContainer Orientation="Horizontal" Margin="10 2 5 0" VerticalAlignment="Bottom">
                    <TextureRect StyleClasses="NTLogoDark" Stretch="KeepAspectCentered"
                                 VerticalAlignment="Center" HorizontalAlignment="Right" HorizontalExpand="True" SetSize="19 19" />
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</controls:FancyWindow>
